{
  "name": "astroflow-desktop",
  "version": "0.2.1",
  "description": "astroflow: astrophotography processing with PixInsight and an AI agent",
  "main": "./out/main/index.js",
  "author": "astroflow",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "gen:api": "python ../scripts/dump_openapi.py openapi.json && openapi-typescript openapi.json --default-non-nullable false -o src/renderer/src/api/schema.d.ts",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "electron-vite": "5.0.0",
    "lucide-react": "1.55.0",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-compare-slider": "4.0.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-zoom-pan-pinch": "4.2.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "zustand": "5.0.15"
  }
}
